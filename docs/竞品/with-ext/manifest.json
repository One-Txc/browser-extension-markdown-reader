{
  "manifest_version": 3,
  "name": "MDR 探针 · 带第三方脚本",
  "version": "1.0.0",
  "description": "同 probe-only，另外装入第三方 Markdown Reader 的 content 脚本，用于对照它是否真能拿到目录数据。",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": ["file:///*.md", "file:///*.markdown", "file:///*/", "file:///"],
      "js": ["probe-log.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
