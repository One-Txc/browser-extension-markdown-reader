{
  "name": "markdown-read",
  "version": "1.0.0",
  "private": true,
  "description": "浏览器扩展：直接阅读本地与在线 Markdown 文档",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:all": "npm run build && npm run build:firefox",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-render.mjs && node scripts/test-toc.mjs && node scripts/test-source-view.mjs",
    "preview": "node scripts/make-theme-preview.mjs",
    "testdata": "python scripts/make-testdata.py",
    "check": "npm run typecheck && npm test && npm run build",
    "locales": "python scripts/check-locales.py",
    "icons": "python scripts/make-icons.py",
    "screenshots": "python scripts/resize-screenshots.py",
    "package": "npm run build:all && python scripts/package.py"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  }
}
